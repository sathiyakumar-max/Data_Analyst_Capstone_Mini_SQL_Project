21.High Value Customers: Find customers who spent more than 10,000 in total purchases.

select c.customer_name,sum(o.total_amount) as Total from customers c
left join orders o
on c.customer_id = o.customer_id
group by c.customer_name


22.Best Selling Product: Find the most sold product by quantity.

select p.product_name,p.product_id,sum(oi.quantity) as totalproductpurchased
from products p 
left join order_items oi
on p.product_id =oi.product_id
group by p.product_name,p.product_id;

