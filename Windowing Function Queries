1.Write a query to get all policies purchased by “Rajesh Kumar”.

select c.customer_name,p.policy_type from customer_new c
join policies p
on c.customer_id = p.cust_id where c.customer_name ='Rajesh Kumar';

2.List all claims that are still pending.

select * from claims where claim_status='Pending';

3.Find the top 2 customers who paid the highest total premium.

select c.customer_name,sum(p.premium_amount) as totalPremium,
RANK() OVER(order by sum(p.premium_amount) desc ) as PremiumRank
from customer_new c
join policies p
on c.customer_id = p.cust_id
group by c.customer_name

4.Show customers who never made a claim.

select c.customer_name,c.customer_id,cl.claim_id from customer_new c
left join claims cl
on c.customer_id = cl.cust_id where cl.claim_id IS NULL;

5.Find the average claim amount for each policy type.

select policy_type,Avg(premium_amount) as AvgPremium
from policies 
group by policy_type
