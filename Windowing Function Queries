11.List all employees with their department names.

select en.emp_name,d.department_name from employees_new en
left join departments d
on en.department_id=d.department_id


12.Find employees who don’t belong to any department (LEFT JOIN).

select en.emp_name,d.department_name from employees_new en
left join departments d
on en.department_id=d.department_id where d.department_name IS NULL

13.Find total salary paid per department.

select department_id,sum(salary) as totalsalary from employees_new
group by department_id


14.Show orders along with customer names (JOIN ecommerce_sales with customers).

select c.first_name,sum(p.amount) as totalamt from customers c
left join payments p
on c.customer_id=p.customer_id
group by c.first_name;


15.Which customers never placed an order?

select c.first_name,sum(p.amount) as totalamt from customers c
left join payments p
on c.customer_id=p.customer_id
group by c.first_name having totalamt IS NULL;
